# Variables lues par docker compose (copier en deploy/.env sur le VPS, jamais versionné).

# Mot de passe PostgreSQL. Ne le changer que sur une base neuve : Postgres ne relit
# POSTGRES_PASSWORD qu'à la création du volume.
POSTGRES_PASSWORD=

# Jeton partagé entre l'API et les workers du solveur (VPS et postes locaux).
# Sans lui, l'API refuse les workers (503).
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SOLVER_WORKER_TOKEN=

# Version déployée : une étiquette git (ex. v2026.10.09) plutôt que master, pour
# qu'un push ne parte pas en production sans décision. Défaut : master.
DEPLOY_REF=master
